# ── Spotify API credentials ────────────────────────────────────────────────────
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ── Spotify OAuth redirect URI ─────────────────────────────────────────────────
# Change this to your server's IP or domain:
#   Local network:  http://192.168.1.100:8000/api/spotify/callback
#   Public server:  http://your-domain.com:8000/api/spotify/callback
# Also add this exact URI to your Spotify app's Redirect URIs in the dashboard!
SPOTIFY_REDIRECT_URI=http://YOUR_SERVER_IP:8000/api/spotify/callback
