# ── Spotify API credentials ────────────────────────────────────────────────────
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ── ngrok tunnel ───────────────────────────────────────────────────────────────
# Get these from: https://dashboard.ngrok.com
# NGROK_AUTHTOKEN — your personal auth token (dashboard → Your Authtoken)
# NGROK_DOMAIN    — your free static domain  (dashboard → Cloud Edge → Domains)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-static-domain.ngrok-free.app

# ── App base URL ───────────────────────────────────────────────────────────────
# Must match your ngrok static domain (with https://).
# Used for Spotify OAuth redirect and post-login redirect back to the UI.
APP_BASE_URL=https://your-static-domain.ngrok-free.app

# ── Spotify OAuth redirect URI ─────────────────────────────────────────────────
# Auto-derived from APP_BASE_URL — usually no need to set this manually.
# Make sure this exact URL is also added in Spotify Dashboard → Redirect URIs!
# SPOTIFY_REDIRECT_URI=https://your-static-domain.ngrok-free.app/api/spotify/callback
