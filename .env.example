# ==============================================================================
# UTubeMp3 - LOCAL (Windows) configuration
# Copy to `.env` in the project root (local\install.bat does it for you).
# Everything here is optional. For Docker use docker/.env.example instead.
# ==============================================================================

# ── Spotify (optional) ─────────────────────────────────────────────────────────
# Get these from https://developer.spotify.com/dashboard -> your app.
# In the app settings add this Redirect URI:  http://127.0.0.1:8000/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Paths (defaults: <project>\downloads and <project>\downloads.db) ───────────
# DOWNLOADS_DIR=D:\Music\UTubeMp3
# DB_PATH=D:\Music\UTubeMp3\downloads.db

# ── Downloads ──────────────────────────────────────────────────────────────────
# Also push every finished MP3 to the browser's "Downloads" folder.
# AUTO_BROWSER_DOWNLOAD=false
# MAX_CONCURRENT_DOWNLOADS=3

# Force a JS runtime for yt-dlp (auto-detected: deno, node, bun)
# YTDLP_JS_RUNTIME=node

# YouTube cookies for "Sign in to confirm you're not a bot" errors
# (default: cookies.txt in the project root, used automatically if present)
# YTDLP_COOKIES_FILE=D:\Music\cookies.txt
