# ── Spotify API credentials ────────────────────────────────────────────────────
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ── App base URL ───────────────────────────────────────────────────────────────
# The public URL where the app is accessible (your server IP or domain).
# Used for Spotify OAuth redirect and post-login redirect back to the UI.
# Examples:
#   Local network:  http://192.168.1.100:8000
#   Public server:  http://your-domain.com:8000
APP_BASE_URL=http://YOUR_SERVER_IP:8090

# ── Spotify OAuth redirect URI ─────────────────────────────────────────────────
# This is auto-derived from APP_BASE_URL above, so usually you don't need to set it.
# Set it manually ONLY if your callback URL differs from APP_BASE_URL/api/spotify/callback.
# Also add the final URI to your Spotify app's Redirect URIs in the dashboard!
# SPOTIFY_REDIRECT_URI=http://YOUR_SERVER_IP:8000/api/spotify/callback
