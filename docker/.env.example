# ==============================================================================
# UTubeMp3 - DOCKER configuration
# Copy to docker/.env and edit. Everything is optional - without this file the
# app still runs at http://<server-ip>:8000 (Spotify features disabled).
# Never commit docker/.env.
# ==============================================================================

# ── Host side ──────────────────────────────────────────────────────────────────
# Port on the host
PORT=8000
# Where /data (MP3s + DB) lives: a named volume (default) or a host folder,
# e.g. ./data (relative to the docker/ folder; must be writable by uid 1000)
# DATA_PATH=./data

# ── Downloads ──────────────────────────────────────────────────────────────────
# After conversion also send the MP3 to the browser (files live on the server)
AUTO_BROWSER_DOWNLOAD=true
MAX_CONCURRENT_DOWNLOADS=3

# YouTube cookies for "Sign in to confirm you're not a bot" errors.
# Default: /data/cookies.txt inside the volume, used automatically if present:
#   docker cp cookies.txt utube-mp3:/data/cookies.txt && docker restart utube-mp3
# YTDLP_COOKIES_FILE=/data/cookies.txt

# ── Spotify (optional) ─────────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard -> your app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Public URL of the app; Spotify redirects back to <APP_BASE_URL>/api/spotify/callback
# (add exactly that URL to Redirect URIs in the Spotify dashboard).
# Spotify accepts plain http only for 127.0.0.1 - for access from other
# devices use HTTPS, e.g. the ngrok tunnel below.
APP_BASE_URL=http://127.0.0.1:8000

# ── ngrok tunnel (optional, start with --profile ngrok) ────────────────────────
# https://dashboard.ngrok.com: Your Authtoken + a free static domain.
# Then set APP_BASE_URL=https://<NGROK_DOMAIN>
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=your-static-domain.ngrok-free.app
