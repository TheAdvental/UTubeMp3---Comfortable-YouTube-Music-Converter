# ==============================================
# UTubeMp3 - Docker Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Application mode
APP_ENV=docker

# Data paths (inside container — use these as-is with docker volumes)
DOWNLOADS_DIR=/data/downloads
DB_PATH=/data/downloads.db

# Server settings
HOST=0.0.0.0
PORT=8000

# Optional: CORS allowed origins (comma-separated)
# Leave as * for open access, or set to your domain
CORS_ORIGINS=*
